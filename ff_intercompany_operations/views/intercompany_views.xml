<odoo>
    <record id="view_agreement_list" model="ir.ui.view">
        <field name="name">ff.intercompany.agreement.list</field>
        <field name="model">ff.intercompany.agreement</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="company_a_id"/><field name="company_b_id"/><field name="status"/><field name="active"/></list></field>
    </record>
    <record id="view_agreement_form" model="ir.ui.view">
        <field name="name">ff.intercompany.agreement.form</field>
        <field name="model">ff.intercompany.agreement</field>
        <field name="arch" type="xml"><form><header><field name="status" widget="statusbar" statusbar_visible="draft,active,expired"/></header><sheet><group><field name="name"/><field name="company_a_id"/><field name="company_b_id"/><field name="active"/><field name="effective_date"/><field name="expiration_date"/></group><group><field name="default_trigger"/><field name="default_approval"/><field name="default_pricing"/><field name="authorized_user_ids" widget="many2many_tags"/></group><notebook><page string="Routes"><field name="route_ids"/></page></notebook></sheet><chatter/></form></field>
    </record>
    <record id="view_counterparty_list" model="ir.ui.view"><field name="name">ff.intercompany.counterparty.list</field><field name="model">ff.intercompany.counterparty</field><field name="arch" type="xml"><list><field name="name"/><field name="agreement_id"/><field name="company_a_id"/><field name="partner_a_id"/><field name="company_b_id"/><field name="partner_b_id"/><field name="active"/></list></field></record>
    <record id="view_counterparty_form" model="ir.ui.view"><field name="name">ff.intercompany.counterparty.form</field><field name="model">ff.intercompany.counterparty</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="agreement_id"/><field name="active"/><field name="role"/></group><group><field name="company_a_id"/><field name="partner_a_id"/><field name="company_b_id"/><field name="partner_b_id"/></group></sheet></form></field></record>
    <record id="view_route_list" model="ir.ui.view"><field name="name">ff.intercompany.route.list</field><field name="model">ff.intercompany.route</field><field name="arch" type="xml"><list><field name="name"/><field name="agreement_id"/><field name="source_company_id"/><field name="destination_company_id"/><field name="source_document"/><field name="target_document"/><field name="active"/></list></field></record>
    <record id="view_route_form" model="ir.ui.view"><field name="name">ff.intercompany.route.form</field><field name="model">ff.intercompany.route</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="agreement_id"/><field name="counterparty_mapping_id"/><field name="source_company_id"/><field name="destination_company_id"/><field name="source_document"/><field name="target_document"/><field name="trigger"/><field name="approval_policy"/><field name="pricing_policy"/><field name="active"/></group><group><field name="source_partner_id"/><field name="destination_partner_id"/><field name="source_warehouse_id"/><field name="destination_warehouse_id"/><field name="integration_user_id"/></group></sheet></form></field></record>
    <record id="view_event_list" model="ir.ui.view"><field name="name">ff.intercompany.event.list</field><field name="model">ff.intercompany.event</field><field name="arch" type="xml"><list><field name="name"/><field name="source_model"/><field name="source_res_id"/><field name="target_model"/><field name="target_res_id"/><field name="route_id"/><field name="state"/><field name="approval_status"/><field name="attempt_count"/><field name="last_attempt"/></list></field></record>
    <record id="action_agreements" model="ir.actions.act_window"><field name="name">Company Agreements</field><field name="res_model">ff.intercompany.agreement</field><field name="view_mode">list,form</field></record>
    <record id="action_routes" model="ir.actions.act_window"><field name="name">Synchronization Routes</field><field name="res_model">ff.intercompany.route</field><field name="view_mode">list,form</field></record>
    <record id="action_counterparties" model="ir.actions.act_window"><field name="name">Counterparty Mappings</field><field name="res_model">ff.intercompany.counterparty</field><field name="view_mode">list,form</field></record>
    <record id="action_events" model="ir.actions.act_window"><field name="name">Synchronization Events</field><field name="res_model">ff.intercompany.event</field><field name="view_mode">list,form</field></record>
    <record id="res_partner_view_intercompany_marker" model="ir.ui.view"><field name="name">res.partner.form.intercompany.marker</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//sheet//field[@name='name']" position="after"><field name="intercompany_status" widget="badge" invisible="not intercompany_status" decoration-info="intercompany_status == 'counterparty'"/></xpath></field></record>
    <menuitem id="menu_intercompany_root" name="Intercompany Operations" groups="ff_intercompany_operations.group_intercompany_user"/>
    <menuitem id="menu_agreements" name="Company Agreements" parent="menu_intercompany_root" action="action_agreements" groups="ff_intercompany_operations.group_intercompany_manager"/>
    <menuitem id="menu_routes" name="Synchronization Routes" parent="menu_intercompany_root" action="action_routes" groups="ff_intercompany_operations.group_intercompany_manager"/>
    <menuitem id="menu_counterparties" name="Counterparty Mappings" parent="menu_intercompany_root" action="action_counterparties" groups="ff_intercompany_operations.group_intercompany_manager"/>
    <menuitem id="menu_events" name="Synchronization Events" parent="menu_intercompany_root" action="action_events"/>
</odoo>
