<odoo>
    <record id="sale_order_view_intercompany" model="ir.ui.view">
        <field name="name">sale.order.form.intercompany</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_intercompany_document" readonly="1" groups="ff_intercompany_operations.group_intercompany_user"/>
                <field name="intercompany_sync_state" readonly="1" groups="ff_intercompany_operations.group_intercompany_user"/>
                <field name="intercompany_counterpart_ref" readonly="1" groups="ff_intercompany_operations.group_intercompany_user"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <button name="action_view_intercompany_status" type="object" string="Intercompany Links" class="oe_stat_button" icon="fa-exchange" groups="ff_intercompany_operations.group_intercompany_user" invisible="not is_intercompany_document"/>
                <button name="action_intercompany_sync" type="object" string="Synchronize Manually" class="oe_stat_button" icon="fa-refresh" groups="ff_intercompany_operations.group_intercompany_manager" invisible="state not in ('sale', 'done')"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_order_view_intercompany" model="ir.ui.view">
        <field name="name">purchase.order.form.intercompany</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_intercompany_document" readonly="1" groups="ff_intercompany_operations.group_intercompany_user"/>
                <field name="intercompany_sync_state" readonly="1" groups="ff_intercompany_operations.group_intercompany_user"/>
                <field name="intercompany_counterpart_ref" readonly="1" groups="ff_intercompany_operations.group_intercompany_user"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <button name="action_view_intercompany_status" type="object" string="Intercompany Links" class="oe_stat_button" icon="fa-exchange" groups="ff_intercompany_operations.group_intercompany_user" invisible="not is_intercompany_document"/>
                <button name="action_intercompany_sync" type="object" string="Synchronize Manually" class="oe_stat_button" icon="fa-refresh" groups="ff_intercompany_operations.group_intercompany_manager" invisible="state not in ('purchase', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>
