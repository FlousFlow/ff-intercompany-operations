<odoo>
    <record id="view_intercompany_setup_wizard_form" model="ir.ui.view">
        <field name="name">ff.intercompany.setup.wizard.form</field>
        <field name="model">ff.intercompany.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Intercompany Setup">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Select the other company and the business direction. Odoo will detect the company contacts and create the synchronization setup for you.
                    </div>
                    <group string="1. Companies">
                        <group>
                            <field name="company_a_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_b_id" domain="[('id', '!=', company_a_id)]" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="2. Basic Synchronization">
                        <field name="direction" widget="radio"/>
                        <field name="create_reverse"/>
                        <field name="approval_policy"/>
                    </group>
                    <group>
                        <field name="edit_contacts"/>
                    </group>
                    <group string="Contact Mapping" invisible="not edit_contacts">
                        <field name="partner_a_id" domain="['|', ('company_id', '=', company_b_id), ('company_id', '=', False)]" options="{'no_create': True}"/>
                        <field name="partner_b_id" domain="['|', ('company_id', '=', company_a_id), ('company_id', '=', False)]" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="advanced_settings"/>
                    </group>
                    <group string="Advanced Settings" invisible="not advanced_settings">
                        <field name="name" placeholder="e.g. Company A to Company B"/>
                        <field name="trigger"/>
                        <field name="pricing_policy"/>
                    </group>
                    <div class="alert alert-secondary mt-3" role="status">
                        <p>Simple setup guide</p>
                        <p>1. Choose the two companies.</p>
                        <p>2. Choose the document direction.</p>
                        <p>3. Choose whether the destination document stays a draft.</p>
                        <p>Contacts are detected automatically. Use Contact Mapping only when you need to override them.</p>
                        <p>Advanced Settings are optional and can normally remain unchanged.</p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_setup" type="object" string="Create Synchronization Setup" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_intercompany_setup_wizard" model="ir.actions.act_window">
        <field name="name">Quick Intercompany Setup</field>
        <field name="res_model">ff.intercompany.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_intercompany_quick_setup" name="Quick Setup" parent="menu_intercompany_root" action="action_intercompany_setup_wizard" sequence="1" groups="ff_intercompany_base.group_intercompany_manager"/>
</odoo>
